# Studio Web is the studio's portal of AI Cinema: the studio logs in with its STUDIO account and every screen
# calls the AI Cinema API with that account. Copy to .env.local (git-ignored) and adjust.

# Base URL of the AI Cinema API (with the /api prefix). Default: http://localhost:3001/api
AI_CINEMA_API_URL="http://localhost:3001/api"

# Session cookies are https-only when true. Default: true under `next start` (production), false under `next dev`.
# Set "false" to try a production build over plain http on another machine than localhost.
COOKIE_SECURE=""

# OAuth 2.0 login (Authorization Code + PKCE). The studio signs in on the consent screen of AI_Cinema_FE.
# Base URL of AI_Cinema_FE (the page /oauth/authorize lives there). Default: http://localhost:3000
AI_CINEMA_WEB_URL="http://localhost:3000"
# Public URL of this site; the callback STUDIO_WEB_URL/api/auth/callback must be listed in the API's
# OAUTH_STUDIO_WEB_REDIRECT_URIS. Default: http://localhost:3100
STUDIO_WEB_URL="http://localhost:3100"
# The client seeded by the API (OAUTH_STUDIO_WEB_CLIENT_ID / _SECRET). Leave the secret empty for a public client.
OAUTH_CLIENT_ID="studio-web"
OAUTH_CLIENT_SECRET=""
# "true" also shows the email + password form (local work, tests). Default: on under `next dev`, off in production.
STUDIO_PASSWORD_LOGIN=""
