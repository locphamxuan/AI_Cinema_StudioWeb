# Studio Web is a separate site: it has no AI Cinema account. It reads the studio's mailbox, sends email back,
# and only tells AI Cinema that a film went out (one signed call, see AI_CINEMA_API_URL below).

# --- Telling AI Cinema a film was mailed (so the Creator and Reviewer see it in the app) ----------
# Base URL of the AI Cinema API and the token shared with its STUDIO_WEBHOOK_TOKEN. Either empty = nobody is told.
AI_CINEMA_API_URL="http://localhost:3001/api"
STUDIO_WEBHOOK_TOKEN=""

# --- Where the studio's mail comes from -------------------------------------------------
# imap = read the studio's own Gmail mailbox over IMAP (default), mailtrap = read a Mailtrap sandbox inbox through
# its API, fixtures = canned briefs, no network.
MAIL_SOURCE="imap"

# Gmail: turn on IMAP in Gmail settings and use an app password (needs 2-step verification), not the account password.
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"

# Mailtrap sandbox (only when MAIL_SOURCE="mailtrap")
MAILTRAP_API_TOKEN=""
MAILTRAP_ACCOUNT_ID=""
MAILTRAP_INBOX_ID=""

# Only mail sent to these studio addresses (comma separated) is shown; empty = every hand-off mail of the inbox.
STUDIO_EMAILS=""

# --- Where the replies go (SMTP; Mailtrap sandbox while demoing) -----------------------------
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The studio's name and address in the From line of the films it sends back.
MAIL_FROM_NAME="Studio đối tác"
MAIL_FROM_ADDRESS="studio@aicinema-partner.local"

# --- Access --------------------------------------------------------------------------------
# When set, the site asks for this code once (stored in a cookie). Leave empty on a local machine.
STUDIO_ACCESS_CODE=""

# Folder of the log of films already sent back (default .data).
DATA_DIR=".data"
