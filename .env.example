# Studio Web is a separate site: it has no AI Cinema account and never calls the AI Cinema API.
# It only reads the studio's mailbox and sends email back.

# --- Where the studio's mail comes from -------------------------------------------------
# mailtrap = read the Mailtrap sandbox inbox through its API (demo), fixtures = canned briefs, no network.
MAIL_SOURCE="mailtrap"
MAILTRAP_API_TOKEN=""
MAILTRAP_ACCOUNT_ID=""
MAILTRAP_INBOX_ID=""

# Only mail sent to these studio addresses (comma separated) is shown; empty = every hand-off mail of the inbox.
STUDIO_EMAILS=""

# --- Where the replies go (SMTP; Mailtrap sandbox while demoing) -----------------------------
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The studio's name and address in the From line of the films it sends back.
MAIL_FROM_NAME="Studio đối tác"
MAIL_FROM_ADDRESS="studio@aicinema-partner.local"

# --- Access --------------------------------------------------------------------------------
# When set, the site asks for this code once (stored in a cookie). Leave empty on a local machine.
STUDIO_ACCESS_CODE=""

# Folder of the log of films already sent back (default .data).
DATA_DIR=".data"
